# Copy this file to .env in the project root and fill in production values.
# .env is gitignored, so git pull will not overwrite it.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# After HTTPS works:
# DJANGO_SECURE_SSL=true

# SQLite is the default. Full Postgres switch: README.md section 6.
# DATABASE_URL=postgres://portal:YOUR_DB_PASSWORD@127.0.0.1:5432/portal

# Optional Gunicorn knobs on a server (see gunicorn.conf.py):
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
# GUNICORN_BIND=127.0.0.1:8000
